{
	"name": "n8n-nodes-multiple-upload-request",
	"version": "0.4.0",
	"description": "n8n nodes for multiple file upload with parallel execution and parallel sub-workflow execution",
	"license": "MIT",
	"homepage": "",
	"keywords": [
		"n8n-community-node-package"
	],
	"author": {
		"name": "n8n Community",
		"email": "community@n8n.io"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/OrgGem/n8n-nodes-multiple-upload-request.git"
	},
	"scripts": {
		"build": "n8n-node build",
		"build:watch": "tsc --watch",
		"dev": "n8n-node dev",
		"lint": "n8n-node lint",
		"lint:fix": "n8n-node lint --fix",
		"release": "n8n-node release"
	},
	"files": [
		"dist"
	],
	"n8n": {
		"n8nNodesApiVersion": 1,
		"strict": true,
		"credentials": [
			"dist/credentials/BearerTokenAuthApi.credentials.js",
			"dist/credentials/CustomHeaderAuthApi.credentials.js"
		],
		"nodes": [
			"dist/nodes/MultipleUploadRequest/MultipleUploadRequest.node.js",
			"dist/nodes/ParallelExecuteWorkflow/ParallelExecuteWorkflow.node.js"
		]
	},
	"devDependencies": {
		"@n8n/node-cli": "*",
		"eslint": "9.32.0",
		"prettier": "3.6.2",
		"release-it": "^19.0.4",
		"typescript": "5.9.2"
	},
	"peerDependencies": {
		"n8n-workflow": "*"
	},
	"dependencies": {
		"form-data": "^4.0.5"
	}
}
